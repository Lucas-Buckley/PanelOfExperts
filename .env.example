DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/panel_of_experts"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/panel_of_experts"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-nano-2025-08-07"
JWT_SECRET="replace-with-a-long-random-secret"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"
RESEND_API_KEY=""
PASSWORD_RESET_FROM_EMAIL=""
LLM_MODE="simulated"
LLM_ENABLED="true"
DEBUG_EXPOSE_ERROR_MESSAGES="false"
LLM_MAX_EXPERTS_PER_PANEL="8"
LLM_MAX_USER_PROMPT_CHARS="4000"
LLM_MAX_LIVE_OUTPUT_TOKENS="300"
LLM_MAX_DAILY_TOKENS="2500000"
API_IDEMPOTENCY_REPLAY_TTL_HOURS="24"
API_IDEMPOTENCY_IN_PROGRESS_TTL_SECONDS="600"

