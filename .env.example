DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/panel_of_experts"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/panel_of_experts"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-nano-2025-08-07"
JWT_SECRET="replace-with-a-long-random-secret"
