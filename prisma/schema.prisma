generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                  Int                  @id @default(autoincrement()) @map("account_id")
  email               String               @db.VarChar(255)
  passwordHash        String               @map("password") @db.VarChar(255)
  panels              Panel[]
  idempotencyRequests IdempotencyRequest[]

  @@unique([email])
  @@map("account")
}

model IdempotencyRequest {
  id             Int      @id @default(autoincrement()) @map("idempotency_request_id")
  accountId      Int      @map("account_id")
  endpoint       String   @db.VarChar(128)
  method         String   @db.VarChar(8)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  state          String   @db.VarChar(16)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  expiresAt      DateTime @map("expires_at")
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, endpoint, method, idempotencyKey])
  @@index([expiresAt])
  @@index([accountId, createdAt])
  @@map("idempotency_request")
}

model Panel {
  id             Int            @id @default(autoincrement()) @map("panel_id")
  accountId      Int            @map("account_id")
  name           String         @db.VarChar(255)
  description    String?        @db.VarChar(255)
  instructions   String?
  lastPromptedAt DateTime?      @map("last_prompted_at")
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  experts        Expert[]
  conversations  Conversation[]

  @@index([accountId])
  @@index([lastPromptedAt])
  @@map("panel")
}

model Expert {
  id             Int        @id @default(autoincrement()) @map("expert_id")
  panelId        Int        @map("panel_id")
  name           String     @db.VarChar(255)
  specialization String     @db.VarChar(255)
  soul           String
  position       Int
  panel          Panel      @relation(fields: [panelId], references: [id], onDelete: Cascade)
  responses      Response[]

  @@index([panelId])
  @@unique([panelId, position])
  @@map("expert")
}

model Conversation {
  id             Int       @id @default(autoincrement()) @map("conversation_id")
  panelId        Int       @map("panel_id")
  name           String    @db.VarChar(255)
  lastPromptedAt DateTime? @map("last_prompted_at")
  panel          Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  prompts        Prompt[]

  @@index([panelId])
  @@index([lastPromptedAt])
  @@map("conversation")
}

model Prompt {
  id             Int          @id @default(autoincrement()) @map("prompt_id")
  conversationId Int          @map("conversation_id")
  sequence       Int
  content        String       @db.Text
  llmInputTokens Int          @default(0) @map("llm_input_tokens")
  llmOutputTokens Int         @default(0) @map("llm_output_tokens")
  llmTotalTokens Int          @default(0) @map("llm_total_tokens")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responses      Response[]

  @@index([conversationId])
  @@index([createdAt])
  @@unique([conversationId, sequence])
  @@map("prompt")
}

model LlmUsageDaily {
  usageDate  DateTime @map("usage_date") @db.Date
  model      String   @db.VarChar(255)
  usedTokens Int      @default(0) @map("used_tokens")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([usageDate, model])
  @@map("llm_usage_daily")
}

model Response {
  id        Int      @id @default(autoincrement()) @map("response_id")
  promptId  Int      @map("prompt_id")
  expertId  Int      @map("expert_id")
  sequence  Int
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([expertId])
  @@index([createdAt])
  @@unique([promptId, sequence])
  @@map("response")
}
